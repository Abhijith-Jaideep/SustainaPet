# Copy to .env and fill in. .env is gitignored; this file is not.

# PostgreSQL. db.py refuses to start unless all five are set.
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=

# Google Cloud Vision, for receipt OCR. Pick one.
#
# A path to a service account JSON file kept outside the repository:
GOOGLE_APPLICATION_CREDENTIALS=
#
# Or the JSON itself as a single line, which is what most hosts want since
# they have nowhere to put a file:
GOOGLE_APPLICATION_CREDENTIALS_JSON=
#
# With neither set, receipt_parser falls back to the environment's default
# application credentials, which is the right answer on Cloud Run or GKE.
